{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build FsLens (MinGW)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-static-libgcc",
                "-static-libstdc++",
                "-municode",
                "-DUNICODE",
                "-D_UNICODE",
                "-g",
                "-O2",
                "-Isrc",                       // ← 添加头文件搜索路径
                "src/FsLens.cpp",
                "src/scanner.cpp",
                "src/platform/win32.cpp",      // 明确列出
                "-o",
                "FsLens.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}